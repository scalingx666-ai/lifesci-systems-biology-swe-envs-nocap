+    skill_info: dict[str, Any]
+    script_path: Path
+    resolved_input: str | None
+    resolved_input_paths: list[str] | None
+    out_dir: Path
+    user_supplied_output_dir: bool
+    generated_ts: str
+    requested_method: str | None
+    cmd: list[str]
