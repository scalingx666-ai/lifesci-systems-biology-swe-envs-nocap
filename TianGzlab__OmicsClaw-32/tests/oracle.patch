+    normalizer: Any | None = None,
+) -> tuple[str, ...]:
+    if value is None:
+        return ()
+    if isinstance(value, (list, tuple, set)):
+        items = [str(item) for item in value]
+    elif isinstance(value, str):
+        text = value.strip()
+        if not text:
+            return ()
+        items = [text]
+    else:
+        text = str(value).strip()
+        if not text:
+            return ()
+        items = [text]
+
+    if normalizer is not None:
+        items = [normalizer(item) for item in items]
