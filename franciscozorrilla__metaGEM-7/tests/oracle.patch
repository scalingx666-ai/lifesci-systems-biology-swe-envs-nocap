-
 else
+    # Read in options
+    while [[ $1 = -?* ]]; do
+      case $1 in
+        -t|--task) shift; task=${1} ;;
+        -j|--nJobs) shift; njobs=${1} ;;
+        -c|--nCores) shift; ncores=${1} ;;
+        -m|--mem) shift; mem=${1} ;;
+        --endopts) shift; break ;;
+        *) die "invalid option: '$1'." ;;
+      esac
+      shift
+    done
     parse
 
 fi
