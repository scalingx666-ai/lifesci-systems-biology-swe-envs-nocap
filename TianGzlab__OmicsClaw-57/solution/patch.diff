+            transform=ax.transAxes,
+            ha="right",
+            va="top",
+            fontsize=10,
+            color="#475569",
+            bbox={"boxstyle": "round,pad=0.28", "fc": "white", "ec": "#CBD5E1", "alpha": 0.92},
