+        text = f'{config["path"]["root"]}/{config["folder"]["stats"]}/qfilter.stats',
+        plot = f'{config["path"]["root"]}/{config["folder"]["stats"]}/qfilterVis.pdf'
+    shell:
+        """
+        set +u;source activate {config[envs][metabagpipes]};set -u;
+        mkdir -p $(dirname {output.text})
