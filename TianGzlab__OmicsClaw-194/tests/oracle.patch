+# _ensure_trusted_dirs incident.
+CARVED_OUT_SIBLING_SYMBOLS = (
+    # bot.core
+    "DEEP_LEARNING_METHODS",
+    "OMICSCLAW_PY",
+    "_path_names",
+    # bot.skill_orchestration
